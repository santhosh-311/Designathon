# MEP-TMS Backend - FastAPI Environment Configuration

# Server Configuration
API_PORT=8000
API_HOST=0.0.0.0
DEBUG=True
CORS_ORIGINS=https://your-frontend-domain.azurestaticapps.net,https://your-custom-domain.com

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production-use-strong-random-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Email Configuration (Gmail Example)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Attendance Configuration
ATTENDANCE_CUTOFF_TIME=10:00
ABSENT_ALERT_DAYS=3

# Topper Configuration
TOPPER_PERCENTAGE=10

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_FOLDER=uploads

# Judge0 Code Execution
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# LangSmith Observability Configuration
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=mep-tms-backend
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

